# Copy to assistant/.env and fill in. NEVER commit .env itself.
# One bot token per person — create each bot with @BotFather on Telegram.

TELEGRAM_BOT_TOKEN_SOHAN=123456:paste-your-token-here
# TELEGRAM_BOT_TOKEN_BROTHER=
# TELEGRAM_BOT_TOKEN_DAD=

# Microsoft Graph — Outlook READ access for scripts/graph.js (app-only, no
# login). Reuse the SAME values the stock relay uses: copy the three
# MS_GRAPH_* lines from the relay's .env.local
# (~/Projects/grand-empire-stock-inventory-matching/.env.local). The secret
# is sensitive; safe here only because .env is git-ignored — never in chat
# or the repo.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_SECRET=
