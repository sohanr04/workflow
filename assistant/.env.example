# Copy to assistant/.env and fill in. NEVER commit .env itself.
# One bot token per person — create each bot with @BotFather on Telegram.

TELEGRAM_BOT_TOKEN_SOHAN=123456:paste-your-token-here
# TELEGRAM_BOT_TOKEN_BROTHER=
# TELEGRAM_BOT_TOKEN_DAD=

# Microsoft Graph via your OWN Azure app registration (e.g. the company
# relay app). From portal.azure.com -> Entra ID -> App registrations ->
# your app -> Overview. The SECRET is sensitive: this file is only safe
# because .env is git-ignored — never put these in chat or the repo.
# MS365_MCP_CLIENT_ID=
# MS365_MCP_TENANT_ID=
# MS365_MCP_CLIENT_SECRET=
