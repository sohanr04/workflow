{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"]
    },
    "gcal": {
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"]
    },
    "//outlook": "Outlook is NOT an MCP — it's read via scripts/graph.js (app-only Graph, all 3 boxes, no login). The old @softeria/ms-365-mcp-server needed an interactive device-code sign-in and was removed.",
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--user-data-dir",
        "/home/EDIT_ME/.alfred-browser"
      ]
    }
  }
}
